# AI Provider（作者本机侧）配置模板
# 用法：cp .env.example .env 后填写；.env 已被 .gitignore 忽略，切勿提交。
#
# ⚠️ 硬约束：本机的 Ollama / LM Studio **只监听 127.0.0.1**，不得 --host 0.0.0.0，
#    不得做路由器端口映射 / UPnP。本机模型服务的 HTTP 接口默认无鉴权，
#    暴露公网等于把算力白送（设计文档 §7.1）。

# ── 必填 ────────────────────────────────────────────────────────────────
# 生产填 wss://你的域名/api/ai/tunnel；本地联调改 ws://127.0.0.1:3000/api/ai/tunnel
AI_SERVER_URL=wss://your-domain.example/api/ai/tunnel

# 与服务器 .env 里 AI_PROVIDER_TOKEN **完全相同**的预共享 token。
# 生成方式：openssl rand -hex 32（服务器上那份用同一个值）
AI_PROVIDER_TOKEN=replace-me-with-openssl-rand-hex-32

# ── 可选 ────────────────────────────────────────────────────────────────
# 本机实例唯一标识。同 id 再次接入 = 同一台机器闪断重连（旧连接会被顶掉）；
# 不同 id 在单活模式下会被拒绝（4409 provider_conflict）。
AI_PROVIDER_ID=mac-studio

# 抢占优先级：值小者优先。当前版本仅在同 id 重连判定中使用。
AI_PROVIDER_PRIORITY=100

# 声明本机可并行处理几个请求。默认 1（多请求并发喂给 Ollama 会让单请求延迟成倍上升，
# 总吞吐几乎不涨，但每个人等待都变长）。机器很强且模型小时可试 2。
AI_PROVIDER_MAX_CONCURRENCY=1

# 上报给服务器的模型名（服务器未指定模型时取它）
AI_UPSTREAM_MODEL=qwen2.5:7b-instruct

# 本机上游地址：Ollama 默认 :11434/v1，LM Studio 换 :1234/v1
AI_UPSTREAM_BASE=http://127.0.0.1:11434/v1

# 多数本地实现不校验此 Key，填占位即可
AI_UPSTREAM_API_KEY=ollama

# 断线重连退避：base=1s → 2 → 4 → 8 → 16 → 30(上限)，每步叠加 ±20% 抖动
AI_RECONNECT_BASE_MS=1000
AI_RECONNECT_MAX_MS=30000

# 被更高优先级实例抢占（4408）后的待命重试间隔（不做指数退避，避免两台机器互踢）
AI_STANDBY_RETRY_SEC=60

# welcome 帧到达前使用的临时心跳间隔；服务器会在 welcome 里给出权威值
AI_HEARTBEAT_SEC=15

# S2 回显开关：1 = 收到 req 原样回一句话（当前阶段，用于验证多路复用）。
# S3 接入真实上游后置 0（置 0 且未接上游时，会回 error 帧 upstream_unavailable）。
AI_PROVIDER_ECHO=1
