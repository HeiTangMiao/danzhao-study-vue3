# 后端环境配置（复制为 .env 使用；node --env-file 自动加载）
# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必替换为强随机值）
JWT_SECRET=change-me-to-a-long-random-secret

# 数据库连接：生产环境填 PostgreSQL 连接串（如 postgres://user:pass@host:5432/db）
# 留空则使用内置 PGlite（嵌入式 PostgreSQL，本地开发用，数据落在 server/data/）
DATABASE_URL=

# 允许的跨域来源（逗号分隔）。线上域名写在这里，代码中不含硬编码域名。
# 留空（或未设置）时回退到仅本地开发地址：http://localhost:5173,http://localhost:3000
#
# ⚠️ 匹配规则是**精确字符串比对**（ALLOWED_ORIGINS.includes(origin)），
#    **不支持通配符** —— 写 http://localhost:* 之类永远不会命中，端口要逐个写全。
#    生产环境请**显式配置**本项（覆盖默认值），否则会退回放行 localhost。
#    注意：origin 的比对含协议与端口，但**不含路径**（写 https://a.com 即可，不要带 /api）。
#
# ⚠️ 若要让 Tauri 客户端（桌面端 / 移动端）访问本后端，必须把它们的来源加进来。
#    Tauri 2 在 WebView 里用自定义 scheme 提供资源，共**三种可能 origin**：
#      tauri://localhost        macOS / Linux / iOS
#      http://tauri.localhost   Windows / Android
#      https://tauri.localhost  Windows / Android（启用 app.windows[].useHttpsScheme 后）
#    三种都建议加上 —— 尤其最后一种：http://tauri.localhost 并非 secure context，
#    Tauri 正在推动切到 https 版本，漏配会导致启用后立刻连不上。
# 示例（按需替换成你的线上域名）：
# ALLOWED_ORIGIN=https://your-domain.com,tauri://localhost,http://tauri.localhost,https://tauri.localhost
ALLOWED_ORIGIN=

# 可信代理（认证限流的 IP 维度依赖它）。nginx 与后端同机回源 → 填 127.0.0.1。
#
# ⚠️ 不填的后果：request.ip 恒为 127.0.0.1 → **全站公网用户共用同一个 IP 桶**，
#    第一个撞线的人会把所有人的注册/登录一起锁死。此时代码会跳过 IP 维度并 console.warn
#    （fail-open：宁可暂时不设防，也不能因为漏配一项就让线上登录挂掉）。
#
# ⚠️ 绝不能填 true / *：那等于信任 X-Forwarded-For 的**最左值**，攻击者伪造该头就能
#    每次换一个新桶，限流形同虚设。填 127.0.0.1 之所以安全：代理地址从**右往左**扫，
#    返回第一个不可信地址；伪造值在左边扫不到，被返回的始终是 nginx 追加的真实来源 IP。
#    多层代理（如 CDN → nginx → 后端）请按逗号分隔逐个列出所有跳的回源 IP。
TRUST_PROXY=127.0.0.1

# ── 认证限流阈值（详见 docs/auth-rate-limit.md）────────────────────────────
# IP 维度，固定窗口：同 IP 在 window 内最多 limit 次
#
# ⚠️ register 10 次/小时对**校园网 / 公司 NAT 出口**偏紧：一个班在同一出口集中注册
#    会互相挤占，表现为"第 11 个人注册就 429"。集中开户场景建议调到 30 或更高。
RATE_REGISTER_PER_IP=10
# login 15 次/5 分钟：留足手抖与切号的余量，同时让爆破脚本 5 分钟只能试 15 次
RATE_LOGIN_PER_IP=15
# refresh 60 次/5 分钟：refresh 由客户端**自动**调用（access 仅 15 分钟有效），
#    阈值必须明显高于 login，否则多标签页/弱网重试的正常用户会被自己绊倒
RATE_REFRESH_PER_IP=60
# （可选）窗口长度，单位秒；默认 3600 / 300 / 300
# RATE_REGISTER_PER_IP_WINDOW_SEC=3600
# RATE_LOGIN_PER_IP_WINDOW_SEC=300
# RATE_REFRESH_PER_IP_WINDOW_SEC=300

# 账号维度，只作用于 login：连续失败 failMax 次 → 封禁 blockMin 分钟，登录成功即清零
RATE_LOGIN_FAIL_MAX=8
RATE_LOGIN_BLOCK_MIN=15

# 限流总开关（留空 = 按环境默认）。
#   留空        → 生产（NODE_ENV=production）开启，其他环境关闭
#   1/true/yes/on  → 强制开启（本地想验证 429 行为时用）
#   0/false/no/off → 强制关闭（限流误伤时紧急关停用）
#   其他任何值   → 无法识别，启动时打 warn 并回退到环境默认
#
# ⚠️ 特地放宽到 false/no/off：限流误伤（如开学集中注册）时运维第一反应就是写 false，
#    只认 '0' 的话会静默落进「生产默认开启」，表现为关不掉，容易被误判成代码坏了。
RATE_LIMIT=
