# 后端环境配置（复制为 .env 使用；node --env-file 自动加载）
# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必替换为强随机值）
JWT_SECRET=change-me-to-a-long-random-secret

# 数据库连接：生产环境填 PostgreSQL 连接串（如 postgres://user:pass@host:5432/db）
# 留空则使用内置 PGlite（嵌入式 PostgreSQL，本地开发用，数据落在 server/data/）
DATABASE_URL=

# 允许的跨域来源（逗号分隔）。线上域名写在这里，代码中不含硬编码域名。
# 留空时回退到仅本地开发地址：http://localhost:5173,http://localhost:3000
#
# ⚠️ 若要让 Tauri 桌面端能访问本后端，必须把桌面端的来源也加进来：
#   macOS / Linux 下 WebView 的 Origin 是 tauri://localhost
#   Windows 下是 http://tauri.localhost
# 示例（按需替换成你的线上域名）：
# ALLOWED_ORIGIN=https://520305.top,tauri://localhost,http://tauri.localhost
ALLOWED_ORIGIN=
