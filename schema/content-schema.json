{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://danzhao.local/schemas/content-schema.json",
  "title": "ContentPageSchema",
  "description": "学习内容页面的区块化结构定义。注意：页面文件只允许导出 blocks；下列 id/unitNum/subject/title/subtitle/icon 由 site.js 注入，出现在内容文件中属于校验硬错误（见 src/content/pageMeta.js 的 PAGE_META_KEYS 与 scripts/validate-content.mjs）。",
  "type": "object",
  "required": ["blocks"],
  "properties": {
    "id": { "type": "string", "description": "页面唯一标识，如 'math-01-01'", "deprecated": true, "deprecationMessage": "由 site.js 推导注入（resolvePageMeta），不要写进内容文件" },
    "unitNum": { "type": "string", "description": "所属单元编号", "deprecated": true, "deprecationMessage": "由 site.js 推导注入（resolvePageMeta），不要写进内容文件" },
    "subject": { "type": "string", "enum": ["math", "chinese", "computer"], "deprecated": true, "deprecationMessage": "由学科目录与 site.js 决定，不要写进内容文件" },
    "title": { "type": "string", "description": "页面标题", "deprecated": true, "deprecationMessage": "由 site.js 的 files[] 注入，不要写进内容文件" },
    "subtitle": { "type": "string", "description": "页面副标题", "deprecated": true, "deprecationMessage": "由 site.js 的 files[] 注入，不要写进内容文件" },
    "icon": { "type": "string", "description": "页面图标（emoji）", "deprecated": true, "deprecationMessage": "只属于 site.js 的单元/页面注册项，不要写进内容文件" },
    "blocks": {
      "type": "array",
      "description": "页面区块列表，按顺序渲染",
      "items": { "$ref": "#/definitions/block" }
    }
  },
  "definitions": {
    "block": {
      "type": "object",
      "required": ["type"],
      "description": "通用区块：所有区块共有 type 字段，按 type 分发到不同渲染组件",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mindmap", "objectives", "knowledge", "formula", "table", "warning", "tip", "example", "quiz", "diagram", "errorfocus", "strategy", "exam", "desmos", "columns", "group", "steps", "summary", "compare", "vocab", "code", "cloze"],
          "description": "区块类型"
        },
        "title": { "type": "string", "description": "区块标题" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "mindmap" } } }, "then": { "required": ["mermaid"], "properties": { "mermaid": { "type": "string", "description": "Mermaid 语法代码" } } } },
        { "if": { "properties": { "type": { "const": "objectives" } } }, "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "type": "string" } } } } },
        { "if": { "properties": { "type": { "const": "knowledge" } } }, "then": { "required": ["paragraphs"], "properties": { "paragraphs": { "type": "array", "items": { "type": "string" } }, "variant": { "type": "string", "enum": ["plain", "definition", "aside"], "description": "知识点变体：plain 默认 / definition 定义（左细线）/ aside 补充说明（降字号降色）" } } } },
        { "if": { "properties": { "type": { "const": "formula" } } }, "then": { "required": ["formulas"], "properties": { "formulas": { "type": "array", "items": { "type": "string" } } } } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "required": ["headers", "rows"], "properties": { "headers": { "type": "array", "items": { "type": "string" } }, "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } } } } },
        { "if": { "properties": { "type": { "const": "warning" } } }, "then": { "required": ["text"], "properties": { "text": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "tip" } } }, "then": { "required": ["text"], "properties": { "text": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "example" } } }, "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/exampleItem" } }, "variant": { "type": "string", "enum": ["full", "compact"], "description": "例题变体：full 默认完整 / compact 紧凑" } } } },
        { "if": { "properties": { "type": { "const": "quiz" } } }, "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/quizItem" } } } } },
        { "if": { "properties": { "type": { "const": "diagram" } } }, "then": { "required": ["boardId"], "properties": { "boardId": { "type": "string", "description": "画板标识，对应 src/geometry/boards/<boardId>.js" }, "caption": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "errorfocus" } } }, "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/errorFocusItem" } } } } },
        { "if": { "properties": { "type": { "const": "strategy" } } }, "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/strategyItem" } } } } },
        { "if": { "properties": { "type": { "const": "exam" } } }, "then": { "required": ["items"], "properties": { "duration": { "type": "number", "description": "考试时长（分钟）" }, "totalScore": { "type": "number", "description": "满分" }, "passingScore": { "type": "number", "description": "及格分" }, "items": { "type": "array", "items": { "$ref": "#/definitions/examItem" } } } } },
        { "if": { "properties": { "type": { "const": "desmos" } } }, "then": { "properties": { "initialExpressions": { "type": "array", "items": { "type": "string" }, "description": "初始表达式列表（LaTeX）" } } } },
        { "if": { "properties": { "type": { "const": "columns" } } }, "then": { "required": ["items"], "properties": { "cols": { "type": "number", "enum": [2, 3], "description": "桌面端列数；窄屏自动降单列" }, "gap": { "type": "string", "enum": ["normal", "tight"], "description": "列间距：normal 正常 / tight 紧凑" }, "items": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/definitions/block" } }, "description": "每列是一个区块数组，长度必须与 cols 一致" } } } },
        { "if": { "properties": { "type": { "const": "group" } } }, "then": { "properties": { "variant": { "type": "string", "enum": ["band", "collapse"], "description": "band=分组带（发丝线分隔）；collapse=可折叠分组" }, "collapsed": { "type": "boolean", "description": "collapse 变体初始是否折叠" }, "items": { "type": "array", "items": { "$ref": "#/definitions/block" } } } } },
        { "if": { "properties": { "type": { "const": "steps" } } }, "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/stepItem" }, "description": "编号步骤：渲染时按顺序自动编号，序号由渲染层生成不要写进标题" } } } },
        { "if": { "properties": { "type": { "const": "summary" } } }, "then": { "properties": { "points": { "type": "array", "items": { "type": "string" }, "description": "速记要点：核心结论清单" }, "formulas": { "type": "array", "items": { "type": "string" }, "description": "必背公式：LaTeX 行，块级居中展示" }, "mustKnow": { "type": "array", "items": { "type": "string" }, "description": "必记结论：最容易忘、必须记死的点" } } } },
        { "if": { "properties": { "type": { "const": "compare" } } }, "then": { "required": ["left", "right", "aspects"], "properties": { "left": { "type": "string", "description": "左侧名称：如「列举法」" }, "right": { "type": "string", "description": "右侧名称：如「描述法」" }, "aspects": { "type": "array", "items": { "$ref": "#/definitions/compareAspect" }, "description": "对照维度：每项一行，左右两侧各一句（中性对照，不分对错）" } } } },
        { "if": { "properties": { "type": { "const": "vocab" } } }, "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/vocabItem" } } } } },
        { "if": { "properties": { "type": { "const": "code" } } }, "then": { "required": ["code"], "properties": { "lang": { "type": "string", "description": "语言标签：如 python / cmd / sql，仅作角标，不做语法高亮" }, "code": { "type": "string", "description": "代码文本：按原样等宽显示，会自动去掉行首缩进，不要写行号和围栏" } } } },
        { "if": { "properties": { "type": { "const": "cloze" } } }, "then": { "required": ["items"], "properties": { "items": { "type": "array", "items": { "$ref": "#/definitions/clozeItem" }, "description": "挖空默写：每项一句，用 {{答案}} 标出空位，点击揭晓" } } } }
      ]
    },
    "exampleItem": {
      "type": "object",
      "required": ["question"],
      "properties": {
        "title": { "type": "string", "description": "例题标题" },
        "question": { "type": "string", "description": "题干" },
        "solution": { "type": "string", "description": "解答过程" },
        "answer": { "type": "string", "description": "最终答案" },
        "difficulty": { "type": "string", "enum": ["basic", "medium", "advanced", "sprint"], "description": "难度：基础/中等/提高/冲刺" }
      }
    },
    "quizItem": {
      "type": "object",
      "required": ["question", "answer"],
      "properties": {
        "question": { "type": "string", "description": "题目内容" },
        "type": { "type": "string", "enum": ["single", "judge", "fill"], "description": "题型：单选/判断/填空" },
        "options": { "type": "array", "items": { "type": "string" }, "description": "选择题选项（可选）" },
        "correctIndex": { "type": "number", "description": "选择题正确选项索引（可选）" },
        "answer": { "type": "string", "description": "答案与解析" },
        "difficulty": { "type": "string", "enum": ["basic", "medium", "advanced", "sprint"], "description": "难度：基础/中等/提高/冲刺" }
      }
    },
    "stepItem": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "description": "步骤标题：一句话说明这一步做什么" },
        "content": { "type": "string", "description": "步骤说明：可选，支持 **加粗** 与 LaTeX" }
      }
    },
    "compareAspect": {
      "type": "object",
      "required": ["label", "left", "right"],
      "properties": {
        "label": { "type": "string", "description": "对照维度：如「适用场景」" },
        "left": { "type": "string", "description": "左侧说法：支持 **加粗** 与 LaTeX" },
        "right": { "type": "string", "description": "右侧说法：支持 **加粗** 与 LaTeX" }
      }
    },
    "vocabItem": {
      "type": "object",
      "required": ["term", "meaning"],
      "properties": {
        "term": { "type": "string", "description": "术语：词条本身" },
        "pinyin": { "type": "string", "description": "读音：拼音或英文读法，可选" },
        "meaning": { "type": "string", "description": "释义：词条的准确解释" },
        "example": { "type": "string", "description": "例句：可选，给出典型用例" },
        "note": { "type": "string", "description": "备注：可选，易混点或记忆提示" }
      }
    },
    "clozeItem": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "description": "挖空文本：用 {{答案}} 标出空位，如\"海内存知己，{{天涯若比邻}}。\"" }
      }
    },
    "errorFocusItem": {
      "type": "object",
      "required": ["scenario", "commonMistake", "correctApproach"],
      "properties": {
        "scenario": { "type": "string", "description": "易错场景" },
        "commonMistake": { "type": "string", "description": "常见错误" },
        "correctApproach": { "type": "string", "description": "正确思路" },
        "tip": { "type": "string", "description": "避坑提示（可选）" }
      }
    },
    "strategyItem": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string", "description": "技巧标题" },
        "content": { "type": "string", "description": "技巧内容" }
      }
    },
    "examItem": {
      "type": "object",
      "required": ["question", "answer"],
      "properties": {
        "question": { "type": "string", "description": "题目内容" },
        "type": { "type": "string", "enum": ["single", "judge", "fill", "solve"], "description": "题型：单选/判断/填空/解答" },
        "options": { "type": "array", "items": { "type": "string" }, "description": "选择题选项" },
        "correctIndex": { "type": "number", "description": "选择题正确选项索引" },
        "answer": { "type": "string", "description": "答案与解析" },
        "score": { "type": "number", "description": "本题分值" },
        "difficulty": { "type": "string", "enum": ["basic", "medium", "advanced", "sprint"], "description": "难度" }
      }
    }
  }
}
