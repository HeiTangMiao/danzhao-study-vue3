# Dependencies
node_modules/

# 本地缓存（npm-cache 等，含尾随空格的历史目录），不入库
.localdata*/

# Build outputs
dist/
dist-ssr/

# 验证期临时产物（浏览器探针目录 / 临时构建配置 / 一次性脚本），不入库
dist-probe*/
dist-verify*/
tmp-*.mjs
vite.*-tmp.config.mjs
tests/tmp-*.test.js

# Generated search index（prebuild 按需生成，不入库）：标题级 meta + 按学科分片的正文
public/search-meta.json
public/search-body/

# Rust / Tauri build outputs
src-tauri/target/
src-tauri/gen/

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Env files
.env
.env.local
.env.*.local

# APK / Android
*.apk
*.aab
*.keystore

# 打包产物 / 离线安装包（含历史误入库的便携版 zip）
release/
*.zip

# 第三方下载缓存（WiX 工具链等，8MB+ 二进制，非源码）
.wix-dl/

# 后端本地数据（PGlite 文件库；server/ 自带 .gitignore 已覆盖，此处显式兜底）
server/data/

# GeoGebra 离线资源（48MB / 203 文件，原直接入库拖慢 clone 与 rsync 部署）
# 改为按需拉取：node scripts/fetch-geogebra.mjs
# 缺失不影响功能 —— GeoGebraPlayground.vue 会自动回退官方 CDN
public/vendor/geogebra/
